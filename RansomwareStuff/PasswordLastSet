$user=get-aduser -filter * -properties "name","passwordlastset" | select -property name,passwordlastset | sort name



$user=get-aduser -filter {enabled -eq $true} -properties "name","userprincipalname","lastlogontimestamp","pwdlastset","department" | select -property name,userprincipalname,@{Name='LastLogon';Expression={[DateTime]::FromFileTime($_.lastlogontimestamp)}},@{Name='PwdLastSet';Expression={[DateTime]::FromFileTime($_.PwdLastSet)}},department | sort name


$user=get-aduser -filter {enabled -eq $true} -properties "name","userprincipalname","lastlogontimestamp","pwdlastset","department",samaccountname | select -property name,userprincipalname,samaccountname,@{Name='LastLogon';Expression={[DateTime]::FromFileTime($_.lastlogontimestamp)}},@{Name='PwdLastSet';Expression={[DateTime]::FromFileTime($_.PwdLastSet)}},department | sort name
